# ═════════════════════════════════════════════════════
# QR Generator Pro - Environment Configuration Template
# Copy this file to .env and fill in your values
# ═════════════════════════════════════════════════════

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram User ID(s) of Bot Owner/Admins (comma-separated, Required)
ADMIN_ID="123456789"

# Bot Display Information (Optional)
BOT_NAME="QR Generator Pro"
BOT_USERNAME="@Qr_Generator_Pro_Robot"
SUPPORT_USERNAME="@YourSupportUsername"

# Channel Integrations (Optional)
# Log channel ID for real-time QR creation notifications (e.g. -1001234567890)
LOG_CHANNEL_ID=""

# Mandatory Channel Subscription (Username or Channel ID, e.g. @YourChannel)
FORCE_SUB_CHANNEL=""

# VPS Deployment Settings (deploy.js)
DEPLOY_HOST="your_vps_ip_here"
DEPLOY_USER="root"
# DEPLOY_PASSWORD="your_vps_password"
# DEPLOY_KEY_PATH="/home/user/.ssh/id_rsa"
